# Copy to .env.local (never commit it) and fill in from Supabase:
#   Project Settings -> API -> Project URL and the "anon public" key.
# The anon key is designed to be public; row-level security protects the data.
# Leave both empty and the site works exactly as before, with no sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
